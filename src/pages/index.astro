---
import { Font } from 'astro:assets';
import Header from '@components/header.astro';
import Footer from '@components/footer.astro';
import Card from '@components/card.astro';
import '@styles/global.css';

import P11 from '@pictures/574ed70e-4b01-4096-9b0b-7d8672bd90ca.png';
import P12 from '@pictures/0e4a9f1e-e518-4b28-a7bc-4f8911fd2022.png';
import P13 from '@pictures/027952ea-e9a8-49e0-bb35-b3b87661fb15.png';
import P14 from '@pictures/269c30ef-e97d-40ad-8f61-1820f0a5e766.png';

import P21 from '@pictures/598af427-2611-4004-b345-3e2cdf861a22.png';
import P22 from '@pictures/28a13607-3163-4742-9e8c-d86c56c6e55d.png';
import P23 from '@pictures/753db765-4103-41e3-997d-67e1f22ec331.png';
import P24 from '@pictures/7851e15f-7c68-475f-8624-f1e1bde7afa0.png';

import P31 from '@pictures/04631002-13e7-4559-935a-1f361e9fc46c.png';
import P32 from '@pictures/9216d1dd-ba0d-4c49-b035-671729a3d8f9.png';
import P33 from '@pictures/6d7910fd-345d-4c43-b8a7-e3cf76409e21.png';
import P34 from '@pictures/3e18a162-e57c-4379-aa50-9aa6055aceec.png';
import P35 from '@pictures/5b987259-718b-41e7-bf47-b9b8724c07c5.png';
import P36 from '@pictures/071d503c-f2df-4d9d-bc65-e48d7847352c.png';
import P37 from '@pictures/1e67d2b6-b011-4cce-bf87-8ce7b7f80d04.png';

const data: {
   images: ImageMetadata[];
   cover: ImageMetadata;
   title: string;
   features: string[];
   price: number;
}[] = [
   {
      images: [P11, P12, P13, P14],
      cover: P11,
      title: 'Página de presentación',
      features: [
         'Página estática',
         'Diseño ajustado a todos los dispositivos',
         'Contiene la información del contacto',
         'Diseño ajustado a los requerimientos del cliente',
         'Sin cambios después de que la página esté en funcionamiento',
      ],
      price: 600,
   },
   {
      images: [P21, P22, P23, P24],
      cover: P21,
      title: 'Anaquel de productos',
      features: [
         'Incluye "Página de presentación"',
         'Inicio de sesión para usuarios',
         'Agregar cualquier cantidad de productos sin la ayuda de los desarrolladores',
         'Asignar precios, nombres de productos, imágenes de referencias y características',
         'Sección de productos con precios en la página de usuarios',
         'Formulario de contacto',
      ],
      price: 2800,
   },
   {
      images: [P31, P32, P33, P34, P35, P36, P37],
      cover: P31,
      title: 'Compra de productos',
      features: [
         'Incluye "Página de presentación"',
         'Incluye "Anaquel de productos"',
         'Historial de órdenes',
         'Asignar cantidad disponible de productos',
         'Carrito de compras',
         'Pasarela de pago en línea incluyendo tarjetas MasterCard, VISA y American Express',
         'Seguimiento de compra para cliente',
         'Etapas para el despacho de productos',
      ],
      price: 5900,
   },
];
---

<html lang="en">
   <head>
      <Font cssVariable="--custom-font-roboto" />
      <meta charset="utf-8" />
      <link
         rel="icon"
         type="image/svg+xml"
         href="/favicon.svg"
      />
      <link
         rel="icon"
         href="/favicon.ico"
      />
      <meta
         name="viewport"
         content="width=device-width"
      />
      <meta
         name="generator"
         content={Astro.generator}
      />
      <title>DGrade Cotización</title>
   </head>
   <body class="flex flex-col items-start justify-start w-full min-h-dvh">
      <Header />
      <main class="w-full flex-auto bg-main grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 p-4 sm:gap-6 sm:p-6 lg:gap-10 lg:p-10">
         {data.map(({ cover, features, images, price, title }) => (
            <Card
               cover={cover}
               features={features}
               images={images}
               price={price}
               title={title}
            />
         ))}
      </main>
      <Footer />
   </body>
</html>
