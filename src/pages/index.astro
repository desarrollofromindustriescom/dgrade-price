---
import { Font } from 'astro:assets';

import '@styles/global.css';

import Header from '@components/header.astro';
import Footer from '@components/footer.astro';
import Card from '@components/card.astro';
import Slider from '@components/slider.astro';

import P11 from '@pictures/574ed70e-4b01-4096-9b0b-7d8672bd90ca.png';
import P21 from '@pictures/598af427-2611-4004-b345-3e2cdf861a22.png';
import P31 from '@pictures/04631002-13e7-4559-935a-1f361e9fc46c.png';

const data: {
   cover: ImageMetadata;
   title: string;
   features: string[];
   price: number;
}[] = [
   {
      cover: P11,
      title: 'Página de presentación',
      features: [
         'Página estática',
         'Diseño ajustado a todos los dispositivos',
         'Contiene la información del contacto',
         'Diseño ajustado a los requerimientos del cliente',
         'Sin cambios después de que la página esté en funcionamiento',
      ],
      price: 600,
   },
   {
      cover: P21,
      title: 'Anaquel de productos',
      features: [
         'Incluye "Página de presentación"',
         'Inicio de sesión para usuarios',
         'Agregar cualquier cantidad de productos sin la ayuda de los desarrolladores',
         'Asignar precios, nombres de productos, imágenes de referencias y características',
         'Sección de productos con precios en la página de usuarios',
         'Formulario de contacto',
      ],
      price: 2800,
   },
   {
      cover: P31,
      title: 'Compra de productos',
      features: [
         'Incluye "Página de presentación"',
         'Incluye "Anaquel de productos"',
         'Historial de órdenes',
         'Asignar cantidad disponible de productos',
         'Carrito de compras',
         'Pasarela de pago en línea incluyendo tarjetas MasterCard, VISA y American Express',
         'Seguimiento de compra para cliente',
         'Etapas para el despacho de productos',
      ],
      price: 5900,
   },
];
---

<html lang="en">
   <head>
      <Font cssVariable="--custom-font-roboto" />
      <meta charset="utf-8" />
      <link
         rel="icon"
         type="image/svg+xml"
         href="/favicon.svg"
      />
      <link
         rel="icon"
         href="/favicon.ico"
      />
      <meta
         name="viewport"
         content="width=device-width"
      />
      <meta
         name="generator"
         content={Astro.generator}
      />
      <title>DGrade Cotización</title>
   </head>
   <body class="flex flex-col items-start justify-start w-full min-h-dvh">
      <Header />
      <main class="w-full flex-auto bg-main grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 p-4 sm:gap-6 sm:p-6 lg:gap-10 lg:p-10">
         {data.map(({ cover, features, price, title }, index) => (
            <Card
               cover={cover}
               features={features}
               index={index}
               price={price}
               title={title}
            />
         ))}
      </main>
      <Footer />
      <Slider />

      <script>
         import { slider } from '@scripts/slider';

         const handleKeyDown = (event: KeyboardEvent) => {
            if (!slider.visible || !(event.key in handlers)) return;
            handlers[event.key]();
         };

         const handlers: Record<string, Function> = {
            Escape: slider.close,
            ArrowLeft: slider.prev,
            ArrowRight: slider.next,
         };

         document.addEventListener('DOMContentLoaded', () => {
            document.addEventListener('keydown', handleKeyDown);
         });
      </script>
   </body>
</html>
