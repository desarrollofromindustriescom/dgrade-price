---
import { Image } from 'astro:assets';
import ChevronRightIcon from '@icons/chevron-right.svg';
import ChevronLeftIcon from '@icons/chevron-left.svg';
import XIcon from '@icons/x.svg';
---

<div
   id="slider"
   class="fixed inset-0 size-full z-100 gap-1 md:gap-4 p-2 md:p-6 hidden grid-cols-[auto_1fr_1fr_auto] md:grid-cols-[auto_1fr_auto] grid-rows-[auto_1fr_0.5fr_auto] md:grid-rows-[auto_1fr_auto] bg-custom-black/95 items-center justify-items-center"
>
   <!-- Header -->
   <button
      id="close-slider"
      type="button"
      class="slider-button col-4 md:col-3 row-1"
   >
      <Image
         src={XIcon}
         alt="close"
      />
   </button>

   <!-- Main -->
   <button
      id="prev-slider"
      type="button"
      class="slider-button col-start-1 col-span-2 md:col-span-1 row-3 md:row-2"
   >
      <Image
         src={ChevronLeftIcon}
         alt="previous"
      />
   </button>

   <div
      id="slider-pictures-wrapper"
      class="size-full overflow-hidden relative col-start-1 col-span-4 md:col-start-2 md:col-span-1 row-2"
   >
      <!-- Pictures will be dynamically inserted here -->
   </div>

   <button
      id="next-slider"
      type="button"
      class="slider-button col-start-3 col-span-2 md:col-start-3 md:col-span-1 row-3 md:row-2"
   >
      <Image
         src={ChevronRightIcon}
         alt="next"
      />
   </button>

   <!-- Footer -->

   <div
      id="slider-index-wrapper"
      class="col-start-1 col-span-4 md:col-span-3 row-4 md:row-3 flex items-center justify-center gap-2 w-full"
   >
      <!-- Index dots will be dynamically inserted here -->
   </div>
</div>

<script>
   import { slider } from '@scripts/slider';

   /**
    * Cleanup after a slide animation ends: removes the transition classes and this listener from the
    * image, and unlocks navigation (onTransition = false) so the buttons and dots respond again.
    */
   const handleRemoveTransition = (event: Event) => {
      const img = event.currentTarget as HTMLImageElement;

      img.classList.remove('transition-all', 'duration-400');
      img.removeEventListener('transitionend', handleRemoveTransition);

      onTransition = false;
   };

   /**
    * Runs when the outgoing image finishes sliding off to the right during a wrap-around (first -> last).
    * After the normal cleanup it parks the image off-screen on the left (-50%), ready for the next cycle.
    */
   const handleSetLeft = (event: Event) => {
      handleRemoveTransition(event);

      const img = event.currentTarget as HTMLImageElement;

      img.removeEventListener('transitionend', handleSetLeft);
      img.style.left = '-50%';
   };

   /**
    * Runs when the outgoing image finishes sliding off to the left during a wrap-around (last -> first).
    * After the normal cleanup it parks the image off-screen on the right (150%), ready for the next cycle.
    */
   const handleSetRight = (event: Event) => {
      handleRemoveTransition(event);

      const img = event.currentTarget as HTMLImageElement;

      img.removeEventListener('transitionend', handleSetRight);
      img.style.left = '150%';
   };

   /**
    * Core animation logic: moves from the current slide (slider.index) to `next`, updates slider.index and
    * locks navigation while animating. With `continuous` (prev/next buttons) it handles the looping
    * transitions between first and last images; without it (dots) it jumps directly to any slide,
    * pre-positioning the skipped images off-screen so they don't appear during the slide.
    */
   const handleGoToSlide = (next: number, continuous: boolean) => {
      const pictures: HTMLImageElement[] = [...picturesWrapper.querySelectorAll<HTMLImageElement>('img')];
      const prev: number = slider.index;

      slider.index = next;
      onTransition = true;

      /**
       * Shared setup for every transition: enables the CSS transition on both the outgoing and incoming
       * images, registers the cleanup listener on the incoming one and slides it to the center (50%).
       */
      const commonSetup = () => {
         pictures[prev].classList.add('transition-all', 'duration-400');
         pictures[next].classList.add('transition-all', 'duration-400');

         pictures[next].addEventListener('transitionend', handleRemoveTransition);
         pictures[next].style.left = '50%';
      };

      if (continuous) {
         if (next > prev) {
            if (prev === 0 && next === slider.length - 1) {
               /**
                * Second phase of the first -> last wrap-around: once the incoming (last) image has been
                * instantly repositioned (1ms transition), runs the real animation moving the old image right.
                */
               const handle = (event: Event) => {
                  (event.currentTarget as HTMLImageElement).removeEventListener('transitionend', handle);
                  (event.currentTarget as HTMLImageElement).classList.remove('duration-1');

                  commonSetup();

                  pictures[prev].addEventListener('transitionend', handleSetLeft);
                  pictures[prev].style.left = '150%';
               };

               pictures[next].addEventListener('transitionend', handle);
               pictures[next].classList.add('transition-all', 'duration-1');

               for (let i: number = 0; i < pictures.length; i++) {
                  if (i === prev) continue;
                  pictures[i].style.left = '-50%';
               }

               return;
            }

            commonSetup();

            pictures[prev].addEventListener('transitionend', handleRemoveTransition);
            pictures[prev].style.left = '-50%';

            return;
         }

         if (prev === slider.length - 1 && next === 0) {
            /**
             * Second phase of the last -> first wrap-around: once the incoming (first) image has been
             * instantly repositioned (1ms transition), runs the real animation moving the old image left.
             */
            const handle = (event: Event) => {
               (event.currentTarget as HTMLImageElement).removeEventListener('transitionend', handle);
               (event.currentTarget as HTMLImageElement).classList.remove('duration-1');

               commonSetup();

               pictures[prev].addEventListener('transitionend', handleSetRight);
               pictures[prev].style.left = '-50%';
            };

            pictures[next].addEventListener('transitionend', handle);
            pictures[next].classList.add('transition-all', 'duration-1');

            for (let i: number = 0; i < pictures.length; i++) {
               if (i === prev) continue;
               pictures[i].style.left = '150%';
            }

            return;
         }

         commonSetup();

         pictures[prev].addEventListener('transitionend', handleRemoveTransition);
         pictures[prev].style.left = '150%';

         return;
      }

      if (next > prev) {
         for (let i: number = prev + 1; i < next; i++) {
            pictures[i].style.left = '-50%';
         }

         commonSetup();

         pictures[prev].addEventListener('transitionend', handleRemoveTransition);
         pictures[prev].style.left = '-50%';

         return;
      }

      for (let i: number = prev - 1; i > next; i--) {
         pictures[i].style.left = '150%';
      }

      commonSetup();

      pictures[prev].addEventListener('transitionend', handleRemoveTransition);
      pictures[prev].style.left = '150%';
   };

   /**
    * Limits every image's max width to a 4:3 ratio of the wrapper's current height, so images keep their
    * proportions and never overflow horizontally. Called when drawing pictures and on window resize.
    */
   const handleSetMaxWidth = () => {
      const rect: DOMRect = picturesWrapper.getBoundingClientRect();
      const pictures: HTMLImageElement[] = [...picturesWrapper.querySelectorAll('img')];

      for (let i: number = 0; i < pictures.length; i++) {
         pictures[i].style.maxWidth = `${(rect.height / 3) * 4}px`;
      }
   };

   /**
    * Updates the pagination dots' styles: the previous dot returns to the small inactive style and the
    * new one becomes the wide highlighted dot, giving visual feedback of the current slide.
    */
   const setSelectedDot = (prev: number, next: number) => {
      const current: HTMLButtonElement | null = indexWrapper.querySelector<HTMLButtonElement>(`#slider-dot-${prev}`);
      const selected: HTMLButtonElement | null = indexWrapper.querySelector<HTMLButtonElement>(`#slider-dot-${next}`);

      if (current)
         current.className = `h-3 cursor-pointer rounded-full transition-all w-3 bg-white/40 hover:bg-white/90 focus:bg-white/90`;
      if (selected) selected.className = `h-3 cursor-pointer rounded-full transition-all w-8 bg-main`;
   };

   /**
    * Click handler for the pagination dots: reads the dot's index from its data attribute and jumps
    * directly to that slide (non-continuous). Ignored while an animation is running.
    */
   const handleChangeDot = (event: Event) => {
      if (onTransition) return;

      const target = event.target as HTMLElement;
      const index: number = Number(target.dataset.sliderDot);

      if (isNaN(index)) return;

      const prev: number = slider.index;
      const next: number = index;

      setSelectedDot(prev, next);
      handleGoToSlide(next, false);
   };

   /**
    * Renders one pagination dot button per picture inside the footer wrapper (replacing any previous
    * dots) and attaches the click handler. The dot matching slider.index is drawn as selected.
    */
   const drawIndex = (length: number) => {
      indexWrapper.innerHTML = '';

      for (let i: number = 0; i < length; i++) {
         const dot = document.createElement('button');

         dot.type = 'button';
         dot.id = `slider-dot-${i}`;
         dot.className = `h-3 cursor-pointer rounded-full transition-all ${i === slider.index ? 'w-8 bg-main' : 'w-3 bg-white/40 hover:bg-white/90 focus:bg-white/90'}`;
         dot.setAttribute('data-slider-dot', String(i));
         dot.addEventListener('click', handleChangeDot);

         indexWrapper.appendChild(dot);
      }
   };

   /**
    * Renders the <img> elements of the chosen gallery inside the pictures wrapper (replacing any previous
    * ones). The current slide is centered (left: 50%), the rest are parked off-screen (left: 150%).
    */
   const drawPictures = (pictures: ImageMetadata[]) => {
      picturesWrapper.innerHTML = '';

      for (let i: number = 0; i < pictures.length; i++) {
         const picture: HTMLImageElement = document.createElement('img');

         picture.id = `slider-picture-${i}`;
         picture.src = pictures[i].src;
         picture.alt = `Imagen ${i + 1}`;
         picture.className = `w-[98%] aspect-[4/3] object-fit rounded-lg absolute top-1/2 -translate-x-1/2 -translate-y-1/2 max-h-[98%]`;
         picture.setAttribute('data-slider-picture', String(i));
         picture.style.left = slider.index === i ? '50%' : '150%';

         picturesWrapper.appendChild(picture);
      }

      handleSetMaxWidth();
   };

   /**
    * Exposed as slider.open: opens the slider for the gallery at `index` (ignored if out of range). Resets
    * the state to the first slide, shows the overlay, draws dots and pictures and locks the page scroll.
    */
   const handleOpen = (index: number) => {
      console.log(`Opening slider at index ${index}, ${slider.pictures.length}`);
      if (index > slider.pictures.length - 1) return;

      slider.visible = true;
      slider.index = 0;
      slider.length = slider.pictures[index].length;

      wrapper.classList.remove('hidden');
      wrapper.classList.add('grid');

      drawIndex(slider.pictures[index].length);
      drawPictures(slider.pictures[index]);

      document.body.classList.add('overflow-hidden');
   };

   /**
    * Exposed as slider.close: hides the overlay, marks the slider as not visible and restores page scroll.
    */
   const handleClose = () => {
      slider.visible = false;

      wrapper.classList.remove('grid');
      wrapper.classList.add('hidden');

      document.body.classList.remove('overflow-hidden');
   };

   /**
    * Exposed as slider.prev: goes to the previous slide, looping to the last one from the first, and
    * updates the selected dot before running the continuous animation.
    */
   const handlePrev = () => {
      let index: number = slider.index - 1;

      if (index < 0) index = slider.length - 1;

      setSelectedDot(slider.index, index);
      handleGoToSlide(index, true);
   };

   /**
    * Exposed as slider.next: goes to the next slide, looping to the first one from the last, and
    * updates the selected dot before running the continuous animation.
    */
   const handleNext = () => {
      let index: number = slider.index + 1;

      if (index === slider.length) index = 0;

      setSelectedDot(slider.index, index);
      handleGoToSlide(index, true);
   };

   let wrapper: HTMLDivElement = document.createElement('div');
   let closeButton: HTMLButtonElement = document.createElement('button');
   let prevButton: HTMLButtonElement = document.createElement('button');
   let nextButton: HTMLButtonElement = document.createElement('button');
   let picturesWrapper: HTMLDivElement = document.createElement('div');
   let indexWrapper: HTMLDivElement = document.createElement('div');

   let onTransition: boolean = false;

   window.addEventListener('resize', handleSetMaxWidth);
   /**
    * Initialization once the DOM is ready: looks up the slider elements (aborting if any is missing),
    * wires slider.open/close/prev/next to their handlers and binds the button click events.
    */
   document.addEventListener('DOMContentLoaded', () => {
      let components: (HTMLElement | null)[] = [
         document.querySelector<HTMLDivElement>('#slider'),
         document.querySelector<HTMLButtonElement>('#slider #close-slider'),
         document.querySelector<HTMLButtonElement>('#slider #prev-slider'),
         document.querySelector<HTMLButtonElement>('#slider #next-slider'),
         document.querySelector<HTMLDivElement>('#slider #slider-pictures-wrapper'),
         document.querySelector<HTMLDivElement>('#slider #slider-index-wrapper'),
      ];

      for (let i: number = 0; i < components.length; i++) {
         if (!components[i]) return;
      }

      wrapper = components[0] as HTMLDivElement;
      closeButton = components[1] as HTMLButtonElement;
      prevButton = components[2] as HTMLButtonElement;
      nextButton = components[3] as HTMLButtonElement;
      picturesWrapper = components[4] as HTMLDivElement;
      indexWrapper = components[5] as HTMLDivElement;

      slider.open = handleOpen;
      slider.close = handleClose;
      slider.prev = handlePrev;
      slider.next = handleNext;

      closeButton.addEventListener('click', () => slider.close());
      prevButton.addEventListener('click', () => {
         if (!onTransition) slider.prev();
      });
      nextButton.addEventListener('click', () => {
         if (!onTransition) slider.next();
      });
   });
</script>
