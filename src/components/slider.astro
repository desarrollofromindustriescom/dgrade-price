---
interface Props {
   id: string;
   images: ImageMetadata[];
   alt: string;
}

const { id, images, alt } = Astro.props;

const arrowButton =
   'flex size-12 items-center justify-center rounded-full bg-white text-custom-black transition-all enabled:cursor-pointer enabled:hover:bg-main enabled:hover:text-white disabled:cursor-not-allowed disabled:opacity-30';
---

<div
   id={id}
   data-slider
   role="dialog"
   aria-modal="true"
   aria-label={alt}
   class="fixed inset-0 z-100 hidden grid-cols-2 grid-rows-[1fr_auto_auto] gap-4 bg-custom-black/95 p-4 pt-20 pb-6 data-open:grid sm:grid-cols-[auto_1fr_auto] sm:grid-rows-[1fr_auto]"
>
   <button
      type="button"
      data-slider-close
      aria-label="Cerrar"
      class="absolute top-4 right-4 flex size-12 cursor-pointer items-center justify-center rounded-full bg-white text-custom-black transition-all hover:bg-main hover:text-white"
   >
      <svg
         xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         class="size-6"
      >
         <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
   </button>

   <div class="col-span-2 row-start-1 min-h-0 overflow-hidden sm:col-span-1 sm:col-start-2">
      <div
         data-slider-track
         class="flex h-full transition-transform duration-500 ease-in-out"
      >
         {images.map((image, i) => (
            <div class="h-full w-full shrink-0">
               <img
                  src={image.src}
                  alt={`${alt} ${i + 1}`}
                  class="h-full w-full object-contain"
               />
            </div>
         ))}
      </div>
   </div>

   <button
      type="button"
      data-slider-prev
      aria-label="Anterior"
      class:list={[arrowButton, 'col-start-1 row-start-2 justify-self-center self-center sm:row-start-1']}
   >
      <svg
         xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round"
         class="size-6"
      >
         <path d="M15 5l-7 7 7 7"></path>
      </svg>
   </button>

   <button
      type="button"
      data-slider-next
      aria-label="Siguiente"
      class:list={[
         arrowButton,
         'col-start-2 row-start-2 justify-self-center self-center sm:col-start-3 sm:row-start-1',
      ]}
   >
      <svg
         xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round"
         class="size-6"
      >
         <path d="M9 5l7 7-7 7"></path>
      </svg>
   </button>

   <div class="col-span-2 row-start-3 flex items-center justify-center gap-2 sm:col-span-3 sm:col-start-1 sm:row-start-2">
      {images.map((_, i) => (
         <button
            type="button"
            data-slider-dot={i}
            aria-label={`Ir a la imagen ${i + 1}`}
            class="h-3 w-3 cursor-pointer rounded-full bg-white/40 transition-all hover:bg-white/70 data-active:w-8 data-active:bg-main"
         />
      ))}
   </div>
</div>

<script>
   const getOpenSlider = (): HTMLElement | null => document.querySelector<HTMLElement>('[data-slider][data-open]');

   const goTo = (slider: HTMLElement, target: number): void => {
      const track = slider.querySelector<HTMLElement>('[data-slider-track]')!;
      const dots = [...slider.querySelectorAll<HTMLElement>('[data-slider-dot]')];
      const last: number = dots.length - 1;
      const index: number = Math.min(Math.max(target, 0), last);

      slider.dataset.index = String(index);
      track.style.transform = `translateX(-${index * 100}%)`;

      dots.forEach((dot, i) => dot.toggleAttribute('data-active', i === index));

      slider.querySelector<HTMLButtonElement>('[data-slider-prev]')!.disabled = index === 0;
      slider.querySelector<HTMLButtonElement>('[data-slider-next]')!.disabled = index === last;
   };

   const open = (slider: HTMLElement): void => {
      slider.setAttribute('data-open', '');
      document.body.classList.add('overflow-hidden');
      goTo(slider, 0);
   };

   const close = (slider: HTMLElement): void => {
      slider.removeAttribute('data-open');
      document.body.classList.remove('overflow-hidden');
   };

   document.addEventListener('click', (event: MouseEvent) => {
      const target = event.target as HTMLElement;

      const trigger = target.closest<HTMLElement>('[data-slider-open]');
      if (trigger) {
         const slider = document.getElementById(trigger.dataset.sliderOpen!);
         if (slider) open(slider);
         return;
      }

      const slider = target.closest<HTMLElement>('[data-slider]');
      if (!slider) return;

      const index: number = Number(slider.dataset.index);

      if (target.closest('[data-slider-close]')) close(slider);
      else if (target.closest('[data-slider-prev]')) goTo(slider, index - 1);
      else if (target.closest('[data-slider-next]')) goTo(slider, index + 1);
      else {
         const dot = target.closest<HTMLElement>('[data-slider-dot]');
         if (dot) goTo(slider, Number(dot.dataset.sliderDot));
      }
   });

   document.addEventListener('keydown', (event: KeyboardEvent) => {
      const slider = getOpenSlider();
      if (!slider) return;

      const index: number = Number(slider.dataset.index);

      if (event.key === 'Escape') close(slider);
      else if (event.key === 'ArrowLeft') goTo(slider, index - 1);
      else if (event.key === 'ArrowRight') goTo(slider, index + 1);
   });
</script>
