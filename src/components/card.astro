---
import { Image } from 'astro:assets';
import Price from '@components/price.astro';

interface Props {
   images: ImageMetadata[];
   cover: ImageMetadata;
   title: string;
   features: string[];
   price: number;
}

const { images, cover, title, features, price } = Astro.props;
---

<article
   class="flex flex-col gap-4 rounded-2xl bg-white p-4 shadow-md transition duration-300 hover:-translate-y-3 hover:shadow-2xl hover:scale-[101%]"
   data-images={JSON.stringify(images.map((image) => image.src))}
>
   <Image
      src={cover}
      alt={title}
      class="aspect-4/3 w-full rounded-lg object-cover"
   />
   <h2 class="text-xl font-bold text-custom-black">{title}</h2>
   <ul class="flex list-inside list-disc flex-col gap-0.5">
      {features.map((feature) => (
         <li class="text-sm">{feature}</li>
      ))}
   </ul>
   <div class="mt-auto w-full flex [&_span]:ml-auto [&_span]:text-3xl [&_span]:italic [&_span]:text-main [&_span]:font-semibold">
      <Price value={price} />
   </div>
</article>
