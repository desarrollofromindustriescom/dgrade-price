---
import Price from '@components/price.astro';

interface Props {
   index: number;
   cover: ImageMetadata;
   title: string;
   features: string[];
   price: number;
}

const { index, cover, title, features, price } = Astro.props;
---

<article class="flex flex-col gap-4 rounded-2xl bg-white p-4 shadow-md transition duration-300 hover:-translate-y-3 hover:shadow-2xl hover:scale-[101%]">
   <button
      type="button"
      class="slider-handler w-full cursor-zoom-in"
      data-index={index}
   >
      <img
         src={cover.src}
         alt={title}
         class="aspect-4/3 w-full rounded-lg object-cover shadow-xl"
      />
   </button>
   <h2 class="text-xl sm:text-2xl transition-all font-bold text-custom-black">{title}</h2>

   <div class="w-full flex flex-col">
      {features.map((feature) => (
         <div class="flex flex-row items-start justify-start">
            <div class="flex items-start justify-start text-base sm:text-sm transition-all p-0.5 w-fit">•</div>
            <div class="text-base sm:text-sm transition-all p-0.5 flex-auto text-left">{feature}</div>
         </div>
      ))}
   </div>

   <div class="mt-auto w-full flex [&_span]:ml-auto [&_span]:text-2xl [&_span]:sm:text-3xl [&_span]:italic [&_span]:text-main [&_span]:font-semibold [&_span]:transition-all">
      <Price value={price} />
   </div>
</article>

<script>
   import { slider } from '@scripts/slider';

   document.addEventListener('DOMContentLoaded', () => {
      if (slider.handlers.length > 0) return;

      slider.handlers = [...document.querySelectorAll<HTMLButtonElement>('.slider-handler')];

      for (let i = 0; i < slider.handlers.length; i++) {
         const index: number = Number(slider.handlers[i].dataset.index || '0');
         slider.handlers[i].addEventListener('click', () => slider.open(index));
      }
   });
</script>
