{
   "extends": "astro/tsconfigs/strict",
   "include": [".astro/types.d.ts", "**/*"],
   "exclude": ["dist"],
   "compilerOptions": {
      "paths": {
         "@icons/*": ["./src/assets/icons/*"],
         "@pictures/*": ["./src/assets/pictures/*"],
         "@styles/*": ["./src/styles/*"],
         "@components/*": ["./src/components/*"]
      }
   }
}
